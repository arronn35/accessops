# Percevia browser scan worker.
#
# Container that runs the real Playwright + axe-core engine. The Vercel web app
# does NOT use this image. Default target is Google Cloud Run in HTTP "serve"
# mode (scale-to-zero, woken by Cloud Tasks): see docs/worker-deploy.md.
#
# To run the legacy always-on poller instead (any container host), override the
# command: `tsx worker/index.ts`.
#
# The base image ships Chromium + all system libraries, matched to the
# playwright version in package.json (1.60.0) — do NOT bump one without the
# other.
FROM mcr.microsoft.com/playwright:v1.60.0-jammy

# Pin the worker to the same supported Node major as CI.
COPY --from=node:22-bookworm-slim /usr/local/bin/node /usr/local/bin/node

ENV NODE_ENV=production \
    # Browsers are baked into the base image; don't re-download on install.
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

WORKDIR /app

# Install deps first for layer caching. Need devDependencies (tsx, typescript,
# dotenv) to run the TS worker directly, so do not use --omit=dev.
COPY package.json package-lock.json ./
RUN npm ci --include=dev

# App + worker source. tsconfig.json is required for the @/* path alias that
# tsx resolves at runtime.
COPY tsconfig.json ./
COPY src ./src
COPY worker ./worker
COPY scripts/build-manifest.ts ./scripts/build-manifest.ts
ARG BUILD_COMMIT_SHA
ARG RELEASE_ENVIRONMENT=staging
ARG FIREBASE_PROJECT_ID
ENV BUILD_COMMIT_SHA=$BUILD_COMMIT_SHA RELEASE_ENVIRONMENT=$RELEASE_ENVIRONMENT FIREBASE_PROJECT_ID=$FIREBASE_PROJECT_ID RELEASE_SOURCE_CLEAN=true
RUN node --import tsx scripts/build-manifest.ts

# Docker COPY preserves restrictive local modes (for example 0600). Ensure the
# runtime user can read the application tree without granting write access.
RUN chmod -R a+rX /app

# Run as the non-root user provided by the Playwright base image.
USER pwuser

CMD ["npx", "tsx", "worker/serve.ts"]
