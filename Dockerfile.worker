# AccessOps browser scan worker.
#
# Long-running container that polls Firestore for queued scans and runs the
# real Playwright + axe-core engine. Deploy to any container host (Railway,
# Fly.io, Render, Cloud Run). The Vercel web app does NOT use this image.
#
# The base image ships Chromium + all system libraries, matched to the
# playwright version in package.json (1.60.0) — do NOT bump one without the
# other.
FROM mcr.microsoft.com/playwright:v1.60.0-jammy

ENV NODE_ENV=production \
    # Browsers are baked into the base image; don't re-download on install.
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

WORKDIR /app

# Install deps first for layer caching. Need devDependencies (tsx, typescript,
# dotenv) to run the TS worker directly, so do not use --omit=dev.
COPY package.json package-lock.json ./
RUN npm ci --include=dev

# App + worker source. tsconfig.json is required for the @/* path alias that
# tsx resolves at runtime.
COPY tsconfig.json ./
COPY src ./src
COPY worker ./worker

# Run as the non-root user provided by the Playwright base image.
USER pwuser

CMD ["npx", "tsx", "worker/index.ts"]
