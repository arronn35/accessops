# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# Real dependency dir behind the node_modules symlink; the .nosync suffix
# keeps iCloud Drive from evicting it (repo lives in a synced folder).
/node_modules.nosync
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/worker/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.percevia/

# env files (can opt-in for committing if needed)
.env*

# local plaintext secret material
secrets/*.env
secrets/*.dec
secrets/*.tmp
secrets/*.key

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
test-results/
playwright-report/
playwright/.cache/
e2e/authenticated/.auth/
